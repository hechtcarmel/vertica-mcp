VERTICA_HOST=localhost
VERTICA_PORT=5433
VERTICA_DATABASE=your_database
VERTICA_USER=readonly_user
VERTICA_PASSWORD=replace_me
# All original defaults are preserved.
VERTICA_READONLY_MODE=true
VERTICA_QUERY_TIMEOUT=60000
VERTICA_IDLE_TIMEOUT=3600000
VERTICA_SSL=false
VERTICA_SSL_REJECT_UNAUTHORIZED=true
VERTICA_DEFAULT_SCHEMA=public
VERTICA_CONNECTION_LOAD_BALANCE=false
