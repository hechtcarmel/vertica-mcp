{
  "name": "@hechtcarmel/vertica-mcp",
  "version": "2.0.0",
  "description": "MCP server for Vertica database operations with configurable readonly mode",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "@hechtcarmel/vertica-mcp": "./dist/index.js",
    "vertica-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    ".env.example",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepack": "npm run clean && npm run build",
    "prepare": "npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:compatibility": "npm run build && node --test tests/compatibility/runtime.test.mjs",
    "artifact:prepare": "node scripts/prepare-artifact.mjs"
  },
  "keywords": [
    "mcp",
    "vertica",
    "database",
    "model-context-protocol",
    "claude",
    "ai",
    "readonly",
    "sql"
  ],
  "author": "hechtcarmel@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hechtcarmel/vertica-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/hechtcarmel/vertica-mcp/issues"
  },
  "homepage": "https://github.com/hechtcarmel/vertica-mcp#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "vertica-nodejs": "^1.1.4",
    "zod": "^4.6.7",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "minimatch@3": "^3.1.4",
      "brace-expansion@1": "^1.1.21",
      "picomatch@4": "^4.0.4"
    }
  }
}
